{
  "name": "anki-apkg-parser",
  "type": "module",
  "version": "2.0.0",
  "description": "Nodejs helper for parsing Anki `.apkg` files. You can unpack the deck and get list of notes, cards, media files, models. The database is opened with built-in `node:sqlite`, so you can make any SQL queries yourself",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "Igor Razumov",
  "license": "ISC",
  "scripts": {
    "build": "tsc && cp -r src/protos dist/",
    "test": "npm run build && ava"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "anki",
    "apkg"
  ],
  "publishConfig": {
    "directory": "dist"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "nodeArguments": [
      "--experimental-strip-types"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "protobufjs": "^8.8.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "ava": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
