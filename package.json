{
  "name": "anki-apkg-parser",
  "type": "module",
  "version": "2.0.0",
  "description": "Read Anki deck files (.apkg, .colpkg) in Node.js: notes, cards, note types and media, with full SQL access via node:sqlite",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "Igor Razumov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/74Genesis/anki-apkg-parser.git"
  },
  "bugs": {
    "url": "https://github.com/74Genesis/anki-apkg-parser/issues"
  },
  "homepage": "https://github.com/74Genesis/anki-apkg-parser#readme",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && node -e \"require('fs').cpSync('src/protos', 'dist/protos', {recursive: true})\"",
    "test": "npm run build && ava",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "anki",
    "apkg",
    "colpkg",
    "anki-deck",
    "flashcards",
    "parser",
    "sqlite"
  ],
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "protobufjs": "^8.8.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "ava": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
