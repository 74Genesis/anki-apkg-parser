{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
